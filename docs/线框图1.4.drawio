Cell><mxCell id="p17-feedback-100" value="用户A    [用户追加]    [未读*]    [追加时间]&#10;已关闭 → 处理中&#10;[公开追加：仍能复现，补充操作步骤如下……]" style="rectangle;rounded=0;strokeColor=#222222;fillColor=#FFFFFF;spacingLeft=10;spacingRight=10;html=0;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontColor=#222222;strokeWidth=1;fontSize=14;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="860" y="1450" width="712" height="108" /></mxCell><mxCell id="p17-feedback-101" value="回复与更新状态" style="text;strokeColor=none;fillColor=none;spacingLeft=0;spacingRight=0;html=0;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontColor=#222222;strokeWidth=1;fontSize=16;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="860" y="1581" width="712" height="30" /></mxCell><mxCell id="p17-feedback-102" value="处理中   ▾     （待处理／处理中／已关闭，按当前状态限制）" style="rectangle;rounded=0;strokeColor=#222222;fillColor=#FFFFFF;spacingLeft=10;spacingRight=10;html=0;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontColor=#222222;strokeWidth=1;fontSize=14;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="860" y="1621" width="712" height="42" /></mxCell><mxCell id="p17-feedback-103" value="[管理员处理说明，最多5000字]&#10;回复对用户公开；关闭或重新打开须说明处理结果或原因。" style="rectangle;rounded=0;strokeColor=#222222;fillColor=#FFFFFF;spacingLeft=10;spacingRight=10;html=0;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontColor=#222222;strokeWidth=1;fontSize=14;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="860" y="1682" width="712" height="110" /></mxCell><mxCell id="p17-feedback-104" value="清除处理草稿" style="rectangle;rounded=0;strokeColor=#222222;fillColor=#FFFFFF;spacingLeft=10;spacingRight=10;html=0;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontColor=#222222;strokeWidth=1;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="860" y="1818" width="190" height="36" /></mxCell><mxCell id="p17-feedback-105" value="保存处理记录" style="rectangle;rounded=0;strokeColor=#222222;fillColor=#FFFFFF;spacingLeft=10;spacingRight=10;html=0;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontColor=#222222;strokeWidth=1;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="1380" y="1818" width="190" height="36" /></mxCell><mxCell id="p17-feedback-106" value="仅首次“待处理 → 处理中”允许空说明；其余处理须填写说明。&#10;进入处理中／已关闭后，不能退回待处理。记录保留操作者、时间、前后状态及文字。" style="text;strokeColor=none;fillColor=none;spacingLeft=0;spacingRight=0;html=0;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontColor=#222222;strokeWidth=1;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="860" y="1875" width="712" height="61" /></mxCell><mxCell id="p17-feedback-107" value="E 异常与提醒状态 · 同一抽屉内的条件分支" style="text;strokeColor=none;fillColor=none;spacingLeft=0;spacingRight=0;html=0;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontColor=#222222;strokeWidth=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="2007" width="1560" height="32" /></mxCell><mxCell id="p17-feedback-108" value="场景" style="rectangle;rounded=0;strokeColor=#222222;fillColor=#F4F4F4;spacingLeft=10;spacingRight=10;html=0;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontColor=#222222;strokeWidth=1;fontSize=14;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="2055" width="265" height="42" /></mxCell><mxCell id="p17-feedback-109" value="实际显示／状态" style="rectangle;rounded=0;strokeColor=#222222;fillColor=#F4F4F4;spacingLeft=10;spacingRight=10;html=0;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontColor=#222222;strokeWidth=1;fontSize=14;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="305" y="2055" width="625" height="42" /></mxCell><mxCell id="p17-feedback-110" value="操作与权限边界" style="rectangle;rounded=0;strokeColor=#222222;fillColor=#F4F4F4;spacingLeft=10;spacingRight=10;html=0;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontColor=#222222;strokeWidth=1;fontSize=14;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="930" y="2055" width="670" height="42" /></mxCell><mxCell id="p17-feedback-111" value="操作结果未确认" style="rectangle;rounded=0;strokeColor=#222222;fillColor=#FFFFFF;spacingLeft=10;spacingRight=10;html=0;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontColor=#222222;strokeWidth=1;fontSize=13;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="2097" width="265" height="83" /></mxCell><mxCell id="p17-feedback-112" value="操作结果未确认，原请求和输入已保留。&#10;[查询结果]   [按原请求重试]" style="rectangle;rounded=0;strokeColor=#222222;fillColor=#FFFFFF;spacingLeft=10;spacingRight=10;html=0;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontColor=#222222;strokeWidth=1;fontSize=13;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="305" y="2097" width="625" height="83" /></mxCell><mxCell id="p17-feedback-113" value="查询只读取；查无回执仍保持未知。业务写入不自动重放；未确认时限制关闭／切换，重新登录入口保留。" style="rectangle;rounded=0;strokeColor=#222222;fillColor=#FFFFFF;spacingLeft=10;spacingRight=10;html=0;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontColor=#222222;strokeWidth=1;fontSize=13;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="930" y="2097" width="670" height="83" /></mxCell><mxCell id="p17-feedback-114" value="其他操作更新版本" style="rectangle;rounded=0;strokeColor=#222222;fillColor=#FFFFFF;spacingLeft=10;spacingRight=10;html=0;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontColor=#222222;strokeWidth=1;fontSize=13;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="2180" width="265" height="83" /></mxCell><mxCell id="p17-feedback-115" value="反馈已有更新，文字仍保留；&#10;反馈已被其他操作更新，文字仍保留。" style="rectangle;rounded=0;strokeColor=#222222;fillColor=#FFFFFF;spacingLeft=10;spacingRight=10;html=0;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontColor=#222222;strokeWidth=1;fontSize=13;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="305" y="2180" width="625" height="83" /></mxCell><mxCell id="p17-feedback-116" value="核对新版本后清除草稿并重新填写；原文字可复制，旧版本不能发送。不只改本地版本号绕过校验。" style="rectangle;rounded=0;strokeColor=#222222;fillColor=#FFFFFF;spacingLeft=10;spacingRight=10;html=0;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontColor=#222222;strokeWidth=1;fontSize=13;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="930" y="2180" width="670" height="83" /></mxCell><mxCell id="p17-feedback-117" value="反馈管理权限撤销" style="rectangle;rounded=0;strokeColor=#222222;fillColor=#FFFFFF;spacingLeft=10;spacingRight=10;html=0;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontColor=#222222;strokeWidth=1;fontSize=13;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="2263" width="265" height="83" /></mxCell><mxCell id="p17-feedback-118" value="反馈管理权限已取消。管理记录已清除，&#10;未发送文字可复制，原未知操作可能已执行。" style="rectangle;rounded=0;strokeColor=#222222;fillColor=#FFFFFF;spacingLeft=10;spacingRight=10;html=0;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontColor=#222222;strokeWidth=1;fontSize=13;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="305" y="2263" width="625" height="83" /></mxCell><mxCell id="p17-feedback-119" value="查询／重试管理操作禁用；确认放弃输入后返回我的反馈，必要时联系有权限的反馈管理员核对结果。" style="rectangle;rounded=0;strokeColor=#222222;fillColor=#FFFFFF;spacingLeft=10;spacingRight=10;html=0;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontColor=#222222;strokeWidth=1;fontSize=13;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="930" y="2263" width="670" height="83" /></mxCell><mxCell id="p17-feedback-120" value="未读、已读与读取失败" style="rectangle;rounded=0;strokeColor=#222222;fillColor=#FFFFFF;spacingLeft=10;spacingRight=10;html=0;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontColor=#222222;strokeWidth=1;fontSize=13;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="2346" width="265" height="83" /></mxCell><mxCell id="p17-feedback-121" value="刷新提醒／标为已读；反馈提醒读取失败；&#10;读取失败，当前输入仍保留。" style="rectangle;rounded=0;strokeColor=#222222;fillColor=#FFFFFF;spacingLeft=10;spacingRight=10;html=0;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontColor=#222222;strokeWidth=1;fontSize=13;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="305" y="2346" width="625" height="83" /></mxCell><mxCell id="p17-feedback-122" value="登录／聚焦／30秒轮询及手工刷新。已读只清提醒；过时标记不清新消息，不改变反馈状态或业务批准。" style="rectangle;rounded=0;strokeColor=#222222;fillColor=#FFFFFF;spacingLeft=10;spacingRight=10;html=0;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontColor=#222222;strokeWidth=1;fontSize=13;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="930" y="2346" width="670" height="83" /></mxCell><mxCell id="p17-feedback-123" value="未发送输入与离开保护" style="rectangle;rounded=0;strokeColor=#222222;fillColor=#FFFFFF;spacingLeft=10;spacingRight=10;html=0;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontColor=#222222;strokeWidth=1;fontSize=13;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="2429" width="265" height="83" /></mxCell><mxCell id="p17-feedback-124" value="按操作显示“保留输入并切换？”&#10;或“放弃未发送的系统反馈？”" style="rectangle;rounded=0;strokeColor=#222222;fillColor=#FFFFFF;spacingLeft=10;spacingRight=10;html=0;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontColor=#222222;strokeWidth=1;fontSize=13;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="305" y="2429" width="625" height="83" /></mxCell><mxCell id="p17-feedback-125" value="取消继续填写；确认后才切换或放弃。已提交原文和事件保持；未知结果优先查询，不以关闭抽屉代替确认。" style="rectangle;rounded=0;strokeColor=#222222;fillColor=#FFFFFF;spacingLeft=10;spacingRight=10;html=0;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontColor=#222222;strokeWidth=1;fontSize=13;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="930" y="2429" width="670" height="83" /></mxCell><mxCell id="p17-feedback-126" value="设计说明：列表、详情和提醒错误分别显示在各自区域；反馈不等同正式审核意见。新反馈、用户追加及管理员处理分别保留原请求和输入，按已确认记录恢复。所有示例均为合成占位内容。" style="text;strokeColor=none;fillColor=none;spacingLeft=0;spacingRight=0;html=0;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontColor=#222222;strokeWidth=1;fontSize=13;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="2540" width="1560" height="62" /></mxCell></root></mxGraphModel></diagram>
