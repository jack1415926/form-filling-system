gn=left;verticalAlign=middle;fontStyle=0;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="550" y="438" width="810" height="36" as="geometry" /></mxCell><mxCell id="p02-revision-50" value="ECO流程总览" style="rounded=0;whiteSpace=wrap;strokeColor=#222222;fillColor=#F4F4F4;html=0;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#222222;align=left;verticalAlign=middle;fontStyle=1;spacingLeft=12;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="310" y="510" width="1075" height="46" as="geometry" /></mxCell><mxCell id="p02-revision-51" value="当前填写人：张三" style="text;strokeColor=none;fillColor=none;html=0;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#222222;align=left;verticalAlign=middle;fontStyle=0;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="334" y="578" width="500" height="32" as="geometry" /></mxCell><mxCell id="p02-revision-52" value="本流程审核轮次：第1轮" style="text;strokeColor=none;fillColor=none;html=0;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#222222;align=right;verticalAlign=middle;fontStyle=0;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="975" y="578" width="386" height="32" as="geometry" /></mxCell><mxCell id="p02-revision-53" value="查看基础资料" style="rounded=0;whiteSpace=wrap;strokeColor=#222222;fillColor=#FFFFFF;html=0;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#222222;align=center;verticalAlign=middle;fontStyle=0;spacingLeft=12;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="334" y="636" width="170" height="40" as="geometry" /></mxCell><mxCell id="p02-revision-54" value="进入ECO行动" style="rounded=0;whiteSpace=wrap;strokeColor=#222222;fillColor=#FFFFFF;html=0;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#222222;align=center;verticalAlign=middle;fontStyle=0;spacingLeft=12;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="516" y="636" width="180" height="40" as="geometry" /></mxCell><mxCell id="p02-revision-55" value="提交与准入检查" style="rounded=0;whiteSpace=wrap;strokeColor=#222222;fillColor=#FFFFFF;html=0;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#222222;align=center;verticalAlign=middle;fontStyle=0;spacingLeft=12;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="708" y="636" width="200" height="40" as="geometry" /></mxCell><mxCell id="p02-revision-56" value="意见与历史" style="rounded=0;whiteSpace=wrap;strokeColor=#222222;fillColor=#FFFFFF;html=0;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#222222;align=center;verticalAlign=middle;fontStyle=0;spacingLeft=12;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="920" y="636" width="170" height="40" as="geometry" /></mxCell><mxCell id="p02-revision-57" value="ECO发布" style="rounded=0;whiteSpace=wrap;strokeColor=#222222;fillColor=#F4F4F4;html=0;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#222222;align=left;verticalAlign=middle;fontStyle=1;spacingLeft=12;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="310" y="717" width="1075" height="46" as="geometry" /></mxCell><mxCell id="p02-revision-58" value="指定发布人：用户D" style="text;strokeColor=none;fillColor=none;html=0;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#222222;align=left;verticalAlign=middle;fontStyle=0;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="334" y="787" width="650" height="32" as="geometry" /></mxCell><mxCell id="p02-revision-59" value="本阶段尚未批准，批准后由指定发布人发布。" style="text;strokeColor=none;fillColor=none;html=0;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#222222;align=left;verticalAlign=middle;fontStyle=0;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="334" y="835" width="1025" height="35" as="geometry" /></mxCell><mxCell id="p02-revision-60" value="刷新发布状态" style="rounded=0;whiteSpace=wrap;strokeColor=#222222;fillColor=#FFFFFF;html=0;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#222222;align=center;verticalAlign=middle;fontStyle=0;spacingLeft=12;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="334" y="889" width="180" height="38" as="geometry" /></mxCell><mxCell id="p02-revision-61" value="ECO填写人" style="rounded=0;whiteSpace=wrap;strokeColor=#222222;fillColor=#F4F4F4;html=0;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#222222;align=left;verticalAlign=middle;fontStyle=1;spacingLeft=12;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="310" y="975" width="1075" height="46" as="geometry" /></mxCell><mxCell id="p02-revision-62" value="张三（user1）" style="text;strokeColor=none;fillColor=none;html=0;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#222222;align=left;verticalAlign=middle;fontStyle=0;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="334" y="1042" width="650" height="32" as="geometry" /></mxCell><mxCell id="p02-revision-63" value="刷新填写人" style="rounded=0;whiteSpace=wrap;strokeColor=#222222;fillColor=#FFFFFF;html=0;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#222222;align=center;verticalAlign=middle;fontStyle=0;spacingLeft=12;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="1155" y="1040" width="205" height="38" as="geometry" /></mxCell><mxCell id="p02-revision-64" value="▸ 填写人历史（1条）" style="text;strokeColor=none;fillColor=none;html=0;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#222222;align=left;verticalAlign=middle;fontStyle=0;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="334" y="1110" width="700" height="36" as="geometry" /></mxCell><mxCell id="p02-revision-65" value="展开后：接收时间 · 交接人／历史基线 · 接收人" style="text;strokeColor=none;fillColor=none;html=0;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#222222;align=left;verticalAlign=middle;fontStyle=0;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="334" y="1157" width="1025" height="32" as="geometry" /></mxCell><mxCell id="p02-revision-66" value="状态参考：ECR与ECO的差异" style="rounded=0;whiteSpace=wrap;strokeColor=#222222;fillColor=#F4F4F4;html=0;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#222222;align=left;verticalAlign=middle;fontStyle=1;spacingLeft=12;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="310" y="1240" width="1075" height="46" as="geometry" /></mxCell><mxCell id="p02-revision-67" value="ECR使用“ECR填写 → ECR处理 → ECR发布”三步；发起人显示在总览中，无ECO填写人卡片。" style="text;strokeColor=none;fillColor=none;html=0;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#222222;align=left;verticalAlign=middle;fontStyle=0;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="334" y="1305" width="1025" height="50" as="geometry" /></mxCell><mxCell id="p02-revision-68" value="已批准且为指定发布人时显示“发布ECR／发布ECO”；消息“查看并处理”、待我发布、工程变更均进入此当前流程发布区。发布人与发起人相同或不同，权限一致；已发布隐藏发布按钮。" style="text;strokeColor=none;fillColor=none;html=0;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#222222;align=left;verticalAlign=middle;fontStyle=0;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="334" y="1370" width="1025" height="50" as="geometry" /></mxCell><mxCell id="p02-revision-69" value="已发布ECR：有权限时显示“启动独立ECO”，先选择填写人；已有ECO显示“打开关联ECO”。迟到响应保留既有创建凭据，不重复创建。" style="text;strokeColor=none;fillColor=none;html=0;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#222222;align=left;verticalAlign=middle;fontStyle=0;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="334" y="1435" width="1025" height="50" as="geometry" /></mxCell><mxCell id="p02-revision-70" value="ECO草稿／退回且有权限时，可选择新填写人并“更换填写人”。未确认时显示“查询交接结果／按原请求重试／原账号重新登录”；查无回执不认定交接成功。" style="text;strokeColor=none;fillColor=none;html=0;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#222222;align=left;verticalAlign=middle;fontStyle=0;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="334" y="1500" width="1025" height="50" as="geometry" /></mxCell><mxCell id="p02-revision-71" value="设计说明：发布人与批准人分别配置。结果未知时查询或按原请求重试；发布权限／轮次改变、或已有其他操作创建ECO时，结束不可继续的重试并提示核对，不能冒认原操作成功。" style="text;strokeColor=none;fillColor=none;html=0;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#222222;align=left;verticalAlign=middle;fontStyle=0;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="310" y="1590" width="1075" height="56" as="geometry" /></mxCell></root>
    </mxGraphModel>
  </diagram>
