  <diagram id="p17-system-feedback" name="17 独立系统反馈与反馈管理"><mxGraphModel dx="1640" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1640" pageHeight="2640" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="p17-feedback-001" value="独立系统反馈与反馈管理" style="text;strokeColor=none;fillColor=none;spacingLeft=0;spacingRight=0;html=0;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontColor=#222222;strokeWidth=1;fontSize=25;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="32" width="1560" height="42" /></mxCell><mxCell id="p17-feedback-002" value="与正式审核意见独立，不改变ECR／ECO批准状态。以下为同一右侧抽屉的四个独立状态，并非同时出现；实际抽屉宽760。" style="text;strokeColor=none;fillColor=none;spacingLeft=0;spacingRight=0;html=0;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontColor=#222222;strokeWidth=1;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="88" width="1560" height="42" /></mxCell><mxCell id="p17-feedback-003" value="入口：悬浮“意见与反馈” → “系统反馈”；有反馈管理权限时，顶部另有“反馈管理”快捷入口。&#10;无管理权限只显示“提交反馈／我的反馈”；管理员额外显示“反馈管理”。" style="text;strokeColor=none;fillColor=none;spacingLeft=0;spacingRight=0;html=0;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontColor=#222222;strokeWidth=1;fontSize=14;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="148" width="1560" height="58" /></mxCell><mxCell id="p17-feedback-004" value="A 提交反馈 · 普通用户" style="text;strokeColor=none;fillColor=none;spacingLeft=0;spacingRight=0;html=0;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontColor=#222222;strokeWidth=1;fontSize=17;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="210" width="760" height="30" /></mxCell><mxCell id="p17-feedback-005" value="" style="rectangle;rounded=0;strokeColor=#222222;fillColor=#FFFFFF;spacingLeft=10;spacingRight=