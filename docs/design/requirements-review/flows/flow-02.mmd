flowchart TD
    ENTRY_ECR["入口A：来自图1<br/>ECR提交或重提成功"] --> A
    ENTRY_ECO["入口B：来自图3<br/>ECO提交或重提成功"] --> A
    A["本阶段已提交<br/>状态：审核中（pending）<br/>本轮任务及人员已冻结"] --> UI["办理入口<br/>工作台 → 待我处理<br/>指定给我的任务<br/>打开当前事项"]
    UI --> B{"本轮是否有负责人任务？"}
    B -->|"有"| C["行动负责人进入待我处理<br/>查看授权内容及本人任务"]
    C --> D["填写本人任务结果<br/>评估/完成说明、业务状态、日期"]
    D --> E["保存任务结果<br/>保存不等于确认"]
    E --> F{"确认条件是否满足？"}
    F -->|"否，补充内容"| D
    F -->|"是"| G["负责人显式确认本人任务"]
    G --> H{"所有负责人任务<br/>是否均已确认？<br/>无任务时视为满足"}
    H -->|"否"| C
    H -->|"是"| I{"是否存在未解决的<br/>正式审核意见？"}
    B -->|"无，提交时已明确确认"| I
    A -.->|"若有待复核意见，可与任务处理并行"| J["原意见提出者复核<br/>填写人的回复和修订"]
    I -->|"是"| J
    J -->|"认可并标记解决，重新检查任务"| H
    J -->|"不认可，继续退回"| N
    I -->|"否；任务已全部确认或明确为零"| K["所有指定批准人<br/>分别执行同意操作"]
    K --> L{"指定批准人<br/>是否全部同意？"}
    L -->|"否，仍待批准"| K
    L -->|"是"| M["系统自动转为已批准（approved）<br/>等待指定发布人操作"]
    M --> EXIT["返回图1或图3的发布步骤<br/>由指定发布人进入当前流程发布区"]
    C -.->|"负责人可提出正式意见并退回"| N["负责人或批准人提出正式意见<br/>退回整个当前阶段"]
    A -.->|"指定批准人可直接提出意见并退回"| N
    N --> O["当前轮次标记为已退回（returned）<br/>记录意见，保留提交时冻结的表单快照"]
    O --> P["当前填写人进入修订状态<br/>修改相关表单和人员分配<br/>逐条回应未解决意见"]
    P --> Q["重新校验并提交<br/>创建新轮次、冻结新快照<br/>任务及批准重新计算"]
    Q --> A
