%% Current schema 0029; verified against local MySQL on 2026-10-21.
erDiagram
    direction TB

    change_request {
        bigint id PK "NOT NULL; auto increment"
        varchar(16) status "NOT NULL"
        varchar(255) title "NOT NULL"
        varchar(64) ecr_no "NOT NULL"
        varchar(64) eco_no "NOT NULL"
        longtext affected_products "NOT NULL"
        varchar(255) affected_region "NOT NULL"
        varchar(255) initiating_factory "NOT NULL"
        longtext affected_factories "NOT NULL"
        varchar(255) ccb_owner "NOT NULL"
        varchar(255) change_owner "NOT NULL"
        date planned_eco_date "NULL allowed"
        longtext change_reason "NOT NULL"
        datetime(6) created_at "NOT NULL"
        datetime(6) updated_at "NOT NULL"
        int applicant_id FK "NOT NULL; auth_user; ORM PROTECT"
        varchar(64) eco_no_unique UK "NULL allowed; stored generated"
        varchar(64) ecr_no_unique UK "NULL allowed; stored generated"
        varchar(16) review_mode "NOT NULL"
        datetime(6) submitted_at "NULL allowed"
        int_unsigned current_review_round "NOT NULL"
        int publisher_id FK "NULL allowed; auth_user; ORM PROTECT"
        varchar(8) stage "NOT NULL"
        char(32) eco_creation_request_id "NULL allowed; UUID"
        char(32) publication_request_id "NULL allowed; UUID"
        datetime(6) published_at "NULL allowed"
        int published_by_id FK "NULL allowed; auth_user; ORM PROTECT"
        bigint source_ecr_id FK,UK "NULL allowed; change_request; ORM PROTECT"
        json creation_payload "NOT NULL; original create payload"
        char(32) creation_request_id "NULL allowed; unique with applicant_id"
    }

    eco_filler_event {
        bigint id PK "NOT NULL; auto increment"
        varchar(8) kind "NOT NULL"
        char(32) request_id "NULL allowed; UUID"
        json payload "NOT NULL"
        datetime(6) created_at "NOT NULL"
        int actor_id FK "NULL allowed; auth_user; ORM PROTECT"
        bigint eco_id FK "NOT NULL; change_request; ORM CASCADE"
        int filler_id FK "NOT NULL; auth_user; ORM PROTECT"
        int previous_filler_id FK "NULL allowed; auth_user; ORM PROTECT"
    }

    eco_filler_inbox_read {
        bigint id PK "NOT NULL; auto increment"
        bigint event_id FK "NOT NULL; eco_filler_event; ORM CASCADE"
        int user_id FK "NOT NULL; auth_user; ORM CASCADE"
    }

    review_round {
        bigint id PK "NOT NULL; auto increment"
        int_unsigned number "NOT NULL"
        varchar(16) review_mode "NOT NULL"
        char(32) request_id "NULL allowed; UUID"
        varchar(255) title "NOT NULL"
        varchar(64) ecr_no "NOT NULL"
        varchar(64) eco_no "NOT NULL"
        datetime(6) submitted_at "NOT NULL"
        varchar(16) state "NOT NULL"
        datetime(6) approved_at "NULL allowed"
        datetime(6) returned_at "NULL allowed"
        longtext return_reason "NOT NULL"
        bigint change_id FK "NOT NULL; change_request; ORM CASCADE"
        int returned_by_id FK "NULL allowed; auth_user; ORM PROTECT"
        json submission_payload "NOT NULL; default_generated"
        json form_snapshot "NULL allowed"
    }

    review_record {
        bigint id PK "NOT NULL; auto increment"
        datetime(6) approved_at "NULL allowed"
        int reviewer_id FK "NOT NULL; auth_user; ORM PROTECT"
        bigint round_id FK "NOT NULL; review_round; ORM CASCADE"
        tinyint(1) approval_required "NOT NULL"
    }

    action_task {
        bigint id PK "NOT NULL; auto increment"
        varchar(7) action_key "NOT NULL"
        longtext result "NOT NULL"
        varchar(24) status "NOT NULL"
        date date "NULL allowed"
        int_unsigned version "NOT NULL"
        datetime(6) confirmed_at "NULL allowed"
        int owner_id FK "NOT NULL; auth_user; ORM PROTECT"
        bigint round_id FK "NOT NULL; review_round; ORM CASCADE"
    }

    task_operation {
        bigint id PK "NOT NULL; auto increment"
        char(32) request_id "NOT NULL; UUID"
        varchar(8) kind "NOT NULL"
        json payload "NOT NULL"
        int author_id FK "NOT NULL; auth_user; ORM PROTECT"
        bigint task_id FK "NOT NULL; action_task; ORM CASCADE"
    }

    review_inbox_read {
        bigint id PK "NOT NULL; auto increment"
        varchar(64) signature "NOT NULL"
        datetime(6) read_at "NOT NULL"
        bigint round_id FK "NOT NULL; review_round; ORM CASCADE"
        int user_id FK "NOT NULL; auth_user; ORM CASCADE"
    }

    review_issue {
        bigint id PK "NOT NULL; auto increment"
        varchar(32) tab "NOT NULL"
        varchar(255) location "NOT NULL"
        longtext text "NOT NULL"
        varchar(16) state "NOT NULL"
        int_unsigned version "NOT NULL"
        datetime(6) created_at "NOT NULL"
        int author_id FK "NOT NULL; auth_user; ORM PROTECT"
        bigint change_id FK "NOT NULL; change_request; ORM CASCADE"
        bigint source_round_id FK "NOT NULL; review_round; ORM CASCADE"
    }

    review_issue_event {
        bigint id PK "NOT NULL; auto increment"
        varchar(16) kind "NOT NULL"
        longtext text "NOT NULL"
        varchar(16) state "NOT NULL"
        int_unsigned version "NOT NULL"
        char(32) request_id "NOT NULL; UUID"
        int_unsigned position "NOT NULL"
        json payload "NOT NULL"
        datetime(6) created_at "NOT NULL"
        int author_id FK "NOT NULL; auth_user; ORM PROTECT"
        bigint change_id FK "NOT NULL; change_request; ORM CASCADE"
        bigint issue_id FK "NULL allowed; review_issue; ORM CASCADE"
        bigint round_id FK "NOT NULL; review_round; ORM CASCADE"
    }

    system_feedback {
        bigint id PK "NOT NULL; auto increment"
        varchar(16) category "NOT NULL"
        longtext content "NOT NULL"
        varchar(16) status "NOT NULL"
        char(32) request_id "NOT NULL; UUID"
        int_unsigned version "NOT NULL"
        datetime(6) created_at "NOT NULL"
        datetime(6) updated_at "NOT NULL"
        int submitter_id FK "NOT NULL; auth_user; ORM PROTECT"
    }

    system_feedback_read {
        bigint id PK "NOT NULL; auto increment"
        int_unsigned version "NOT NULL"
        bigint feedback_id FK "NOT NULL; system_feedback; ORM CASCADE"
        int user_id FK "NOT NULL; auth_user; ORM CASCADE"
    }

    system_feedback_event {
        bigint id PK "NOT NULL; auto increment"
        longtext text "NOT NULL"
        varchar(16) from_status "NOT NULL"
        varchar(16) to_status "NOT NULL"
        char(32) request_id "NOT NULL; UUID"
        int_unsigned base_version "NOT NULL"
        datetime(6) created_at "NOT NULL"
        int actor_id FK "NOT NULL; auth_user; ORM PROTECT"
        bigint feedback_id FK "NOT NULL; system_feedback; ORM CASCADE"
        varchar(16) kind "NOT NULL"
    }

    material_change {
        bigint id PK "NOT NULL; auto increment"
        varchar(20) category "NOT NULL"
        varchar(255) material_no "NOT NULL"
        longtext description "NOT NULL"
        varchar(255) material_class "NOT NULL"
        varchar(1) spare_part "NOT NULL"
        varchar(1) optional_part "NOT NULL"
        varchar(255) old_revision "NOT NULL"
        varchar(255) new_revision "NOT NULL"
        varchar(255) revision "NOT NULL"
        varchar(255) detailed_class "NOT NULL"
        varchar(255) discontinued_project "NOT NULL"
        longtext change_description "NOT NULL"
        bigint change_id FK "NOT NULL; change_request; ORM CASCADE"
        char(32) request_id "NULL allowed; UUID"
    }

    material_disposition {
        bigint id PK "NOT NULL; auto increment"
        varchar(16) location_group "NOT NULL"
        varchar(32) location_item "NOT NULL"
        varchar(20) disposition "NOT NULL"
        longtext remark "NOT NULL"
        bigint material_id FK "NOT NULL; material_change; ORM CASCADE"
    }

    question_response {
        bigint id PK "NOT NULL; auto increment"
        smallint_unsigned number "NOT NULL"
        varchar(1) answer "NOT NULL"
        longtext remark "NOT NULL"
        bigint change_id FK "NOT NULL; change_request; ORM CASCADE"
    }

    ecr_action_response {
        bigint id PK "NOT NULL; auto increment"
        varchar(7) action_key "NOT NULL"
        longtext result "NOT NULL"
        varchar(16) status "NOT NULL"
        date date "NULL allowed"
        bigint change_id FK "NOT NULL; change_request; ORM CASCADE"
        tinyint(1) extra_required "NOT NULL"
    }

    eco_action_response {
        bigint id PK "NOT NULL; auto increment"
        varchar(7) action_key "NOT NULL"
        longtext result "NOT NULL"
        varchar(24) status "NOT NULL"
        date date "NULL allowed"
        bigint change_id FK "NOT NULL; change_request; ORM CASCADE"
        tinyint(1) extra_required "NOT NULL"
    }

    execution_plan_response {
        bigint id PK "NOT NULL; auto increment"
        varchar(8) activity_key "NOT NULL"
        varchar(255) owner "NOT NULL"
        date start_date "NULL allowed"
        date end_date "NULL allowed"
        longtext remark "NOT NULL"
        bigint change_id FK "NOT NULL; change_request; ORM CASCADE"
    }

    significant_assessment {
        bigint id PK "NOT NULL; auto increment"
        varchar(24) f_assessment "NOT NULL"
        varchar(16) final_conclusion "NOT NULL"
        bigint change_id FK,UK "NOT NULL; change_request; ORM CASCADE"
    }

    significant_chart_response {
        bigint id PK "NOT NULL; auto increment"
        varchar(1) chart_key "NOT NULL"
        varchar(1) applicability "NOT NULL"
        longtext reason "NOT NULL"
        varchar(16) result "NOT NULL"
        bigint change_id FK "NOT NULL; change_request; ORM CASCADE"
    }

    significant_question_response {
        bigint id PK "NOT NULL; auto increment"
        varchar(16) question_key "NOT NULL"
        varchar(1) answer "NOT NULL"
        longtext reason "NOT NULL"
        bigint change_id FK "NOT NULL; change_request; ORM CASCADE"
    }

    emc_reference {
        bigint id PK "NOT NULL; auto increment"
        varchar(255) title "NOT NULL"
        longtext introduction "NOT NULL"
        longtext legend "NOT NULL"
        longtext definitions "NOT NULL"
        datetime(6) created_at "NOT NULL"
        datetime(6) updated_at "NOT NULL"
        bigint change_id FK,UK "NOT NULL; change_request; ORM CASCADE"
    }

    emc_reference_row {
        bigint id PK "NOT NULL; auto increment"
        varchar(64) key "NOT NULL"
        longtext label "NOT NULL"
        int_unsigned sort_order "NOT NULL"
        bigint reference_id FK "NOT NULL; emc_reference; ORM CASCADE"
    }

    emc_reference_test {
        bigint id PK "NOT NULL; auto increment"
        varchar(64) key "NOT NULL"
        longtext label "NOT NULL"
        varchar(255) group_label "NOT NULL"
        varchar(255) standard_reference "NOT NULL"
        int_unsigned sort_order "NOT NULL"
        bigint reference_id FK "NOT NULL; emc_reference; ORM CASCADE"
    }

    emc_reference_cell {
        bigint id PK "NOT NULL; auto increment"
        varchar(3) mark "NOT NULL"
        longtext remark "NOT NULL"
        bigint reference_id FK "NOT NULL; emc_reference; ORM CASCADE"
        bigint row_id FK "NOT NULL; emc_reference_row; ORM CASCADE"
        bigint test_id FK "NOT NULL; emc_reference_test; ORM CASCADE"
    }

    change_request_stage_approvers {
        bigint id PK "NOT NULL; auto increment"
        bigint changerequest_id FK "NOT NULL; change_request; ORM CASCADE"
        int user_id FK "NOT NULL; auth_user; ORM CASCADE"
    }

    ecr_action_response_owners {
        bigint id PK "NOT NULL; auto increment"
        bigint ecractionresponse_id FK "NOT NULL; ecr_action_response; ORM CASCADE"
        int user_id FK "NOT NULL; auth_user; ORM CASCADE"
    }

    eco_action_response_owners {
        bigint id PK "NOT NULL; auto increment"
        bigint ecoactionresponse_id FK "NOT NULL; eco_action_response; ORM CASCADE"
        int user_id FK "NOT NULL; auth_user; ORM CASCADE"
    }

    %% Business-table FK constraints; auth_user references are annotated in the fields.
    review_round ||--o{ action_task : "round_id"
    change_request |o--o| change_request : "source_ecr_id"
    change_request ||--o{ change_request_stage_approvers : "changerequest_id"
    change_request ||--o{ eco_action_response : "change_id"
    eco_action_response ||--o{ eco_action_response_owners : "ecoactionresponse_id"
    change_request ||--o{ eco_filler_event : "eco_id"
    eco_filler_event ||--o{ eco_filler_inbox_read : "event_id"
    change_request ||--o{ ecr_action_response : "change_id"
    ecr_action_response ||--o{ ecr_action_response_owners : "ecractionresponse_id"
    change_request ||--o| emc_reference : "change_id"
    emc_reference_row ||--o{ emc_reference_cell : "reference_id,row_id"
    emc_reference_test ||--o{ emc_reference_cell : "reference_id,test_id"
    emc_reference ||--o{ emc_reference_cell : "reference_id"
    emc_reference_row ||--o{ emc_reference_cell : "row_id"
    emc_reference_test ||--o{ emc_reference_cell : "test_id"
    emc_reference ||--o{ emc_reference_row : "reference_id"
    emc_reference ||--o{ emc_reference_test : "reference_id"
    change_request ||--o{ execution_plan_response : "change_id"
    change_request ||--o{ material_change : "change_id"
    material_change ||--o{ material_disposition : "material_id"
    change_request ||--o{ question_response : "change_id"
    review_round ||--o{ review_inbox_read : "round_id"
    change_request ||--o{ review_issue : "change_id"
    review_round ||--o{ review_issue : "source_round_id"
    change_request ||--o{ review_issue_event : "change_id"
    review_issue |o--o{ review_issue_event : "issue_id"
    review_round ||--o{ review_issue_event : "round_id"
    review_round ||--o{ review_record : "round_id"
    change_request ||--o{ review_round : "change_id"
    change_request ||--o| significant_assessment : "change_id"
    change_request ||--o{ significant_chart_response : "change_id"
    change_request ||--o{ significant_question_response : "change_id"
    system_feedback ||--o{ system_feedback_event : "feedback_id"
    system_feedback ||--o{ system_feedback_read : "feedback_id"
    action_task ||--o{ task_operation : "task_id"
